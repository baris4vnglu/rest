rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Menü Öğeleri: Herkes okuyabilir, sadece Admin yazabilir
    match /menuItems/{menuItem} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Masalar: Herkes okuyabilir (Masa seçimi için), sadece Admin yazabilir
    match /tables/{table} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Siparişler: Herkes sipariş oluşturabilir, sadece Admin okuyabilir/düzenleyebilir
    match /orders/{order} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }
    
    // 4. Diğer her şey (Ayarlar, Kasa, Müşteriler vb.): Sadece Admin erişebilir
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}